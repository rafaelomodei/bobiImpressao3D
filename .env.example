# bobi. — modelo de variáveis de ambiente.
# Copie para .env.local e preencha. Nunca commite valores reais.

# --- Público (exposto ao navegador) ---
# Supabase > Project Settings > Data API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase > Project Settings > API Keys > Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Somente servidor ---
# Supabase > Project Settings > API Keys > Secret key (sb_secret_...)
# Ignora RLS: usar apenas em código de servidor (route handlers, server actions, seeds).
SUPABASE_SECRET_KEY=

# --- Banco / Supabase CLI ---
SUPABASE_PROJECT_NAME=
# Supabase > Project Settings > General > Reference ID
SUPABASE_PROJECT_REF=
# Senha do Postgres definida na criação do projeto (usada por `supabase link` e migrações)
SUPABASE_DB_PASSWORD=
# Pooler IPv4 (Supabase > Connect > Session pooler), ex.: aws-1-us-west-2.pooler.supabase.com
SUPABASE_DB_POOLER_HOST=
